{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brand-ai-readiness-audit/schemas/audit_report_v2.json",
  "title": "Brand AI Readiness Audit Report",
  "description": "Output schema for the Adobe Brand AI Readiness Audit marketplace. Version 2.0.0.",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "url",
    "timestamp",
    "duration_seconds",
    "ai_readiness_score",
    "score_band",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this schema, e.g. '2.0.0'"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 unique identifier for this audit run"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "The URL that was audited"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of audit start"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Wall-clock seconds the audit took to complete"
    },
    "ai_readiness_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Weighted penalty score. 100 = fully AI-ready. Formula: max(0, 100 - sum(W_severity * count(defect_findings)))"
    },
    "score_band": {
      "type": "string",
      "enum": ["Excellent", "Good", "Fair", "Poor"],
      "description": "Score band: Excellent(80-100), Good(60-79), Fair(40-59), Poor(0-39)"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "description": "All findings sorted by severity. MUST NOT be empty.",
      "items": {
        "$ref": "#/definitions/Finding"
      }
    },
    "cross_web_corroboration": {
      "type": "object",
      "description": "Off-site corroboration and temporal freshness data collected from Wikidata and DuckDuckGo Lite",
      "properties": {
        "brand_name": { "type": "string" },
        "corroboration_status": { "type": "string", "enum": ["ok", "rate_limited", "blocked"] },
        "wikidata_entity_found": { "type": "boolean" },
        "wikidata_qid": { "type": ["string", "null"] },
        "offsite_price_str": { "type": "string" },
        "offsite_price_num": { "type": ["number", "null"] },
        "offsite_year_max": { "type": ["integer", "null"] },
        "offsite_snippets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal warnings from the audit run (schema validation issues, partial failures)",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "Finding": {
      "type": "object",
      "required": ["id", "title", "severity", "type", "evidence", "suggested_action", "check_ref"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[A-Z0-9]+-[A-Z0-9-]+$",
          "description": "Unique finding ID, e.g. F-BOT-001, F-DOM-002, F-ENG-007"
        },
        "title": {
          "type": "string",
          "minLength": 10,
          "description": "Human-readable, specific finding title"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"],
          "description": "Finding severity level"
        },
        "type": {
          "type": "string",
          "enum": ["defect", "proactive"],
          "description": "defect = a problem found. proactive = a passing check or enhancement opportunity."
        },
        "evidence": {
          "type": "string",
          "minLength": 10,
          "description": "Exact evidence from the page/response. Not AI-generated text. Must be machine-verifiable."
        },
        "suggested_action": {
          "$ref": "#/definitions/SuggestedAction"
        },
        "check_ref": {
          "type": "string",
          "pattern": "^CHECK-",
          "description": "Reference to the check specification that produced this finding"
        }
      }
    },
    "SuggestedAction": {
      "type": "object",
      "required": ["summary", "priority", "effort"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10,
          "description": "Specific, mechanism-sound action. Not generic advice."
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "implementation_hint": {
          "type": "string",
          "description": "Optional: specific code/config snippet or tool reference"
        }
      }
    }
  }
}
